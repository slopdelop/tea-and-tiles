# Defaults are deliberately emulator-only. Never point demo mode at a live project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-tea-and-tiles
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tea-and-tiles.firebaseapp.com
VITE_FUNCTIONS_REGION=europe-west2
VITE_EMULATOR_HOST=127.0.0.1
# Optional emulator ports; defaults below preserve normal development sessions.
# The isolated npm run test:ui suite overrides these on separate ports.
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FUNCTIONS_EMULATOR_PORT=5001
VITE_BASE_PATH=/
# Cloud: set false, real public web configuration, and /your-repository/ base path.
VITE_FIREBASE_APP_ID=
# Required for cloud mode; leave empty for local emulator testing.
VITE_APP_CHECK_SITE_KEY=
