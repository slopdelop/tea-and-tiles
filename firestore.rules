rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function bound() {
      return request.auth != null
        && exists(/databases/$(database)/documents/bindings/$(request.auth.uid));
    }
    function slot() {
      return get(/databases/$(database)/documents/bindings/$(request.auth.uid)).data.slot;
    }
    function member() {
      return bound() && slot() in ['mom', 'aunt']
        && validSession(
          get(/databases/$(database)/documents/bindings/$(request.auth.uid)).data,
          get(/databases/$(database)/documents/players/$(slot())).data
        );
    }
    function validSession(binding, player) {
      return player.get('sessionVersion', 0) is int
        && player.get('sessionVersion', 0) >= 0
        && (binding.keys().hasAny(['sessionVersion'])
          ? binding.sessionVersion == player.get('sessionVersion', 0)
          : player.get('sessionVersion', 0) == 0 && player.uid == request.auth.uid);
    }
    match /bindings/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /players/{player} {
      allow get: if member() && slot() == player;
    }
    match /pairs/family {
      allow get: if member();
      match /houseWords/{word} { allow get, list: if member(); }
      match /wordRequests/{requestId} { allow get, list: if member(); }
      match /gameRequests/{requestId} { allow get, list: if member(); }
      match /endGameRequests/{requestId} { allow get, list: if member(); }
      match /presence/{uid} {
        function validHeartbeat() {
          return request.resource.data.keys().hasAll(['slot', 'lastSeen'])
            && request.resource.data.keys().hasOnly(['slot', 'lastSeen'])
            && request.resource.data.slot == slot()
            && request.resource.data.lastSeen is timestamp
            && request.resource.data.lastSeen == request.time;
        }
        allow get, list: if member();
        allow create: if member() && uid == request.auth.uid && validHeartbeat();
        allow update: if member() && uid == request.auth.uid && validHeartbeat()
          && request.time >= resource.data.lastSeen + duration.value(55, 's');
        // Hidden devices expire naturally; deletion cannot bypass throttling.
        allow delete: if false;
      }
    }
    match /games/{gameId} {
      allow get: if member();
      match /racks/{player} { allow get: if member() && slot() == player; }
      match /commands/{commandId} {
        // A member can listen for her not-yet-written receipt. Once it exists,
        // only its submitting UID may read it (including through a listener).
        allow get: if member() && (
          !exists(/databases/$(database)/documents/games/$(gameId)/commands/$(commandId))
          || resource.data.uid == request.auth.uid
        );
      }
      // No read access to private/state (the bag and its draw order).
    }
    // Game writes and all unlisted reads are denied, including setup credentials.
    match /{document=**} { allow read, write: if false; }
  }
}
